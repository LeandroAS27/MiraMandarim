{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../src/shared/**/*.ts", "../src/theme/presence.ts", "../src/theme/classes.ts", "../src/types.ts", "../src/lib/layout.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
